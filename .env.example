# App
APP_ENV=development
SECRET_KEY=change-me-in-production

# Database — use Aurora PostgreSQL URL in production
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/knowledge_rag

# S3 — leave S3_ENDPOINT_URL empty for real AWS S3; set for local MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_RAW=rag-raw-docs
S3_BUCKET_ARTIFACTS=rag-chunk-artifacts
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# OpenAI
OPENAI_API_KEY=sk-...

# Document360
DOCUMENT360_API_KEY=
DOCUMENT360_BASE_URL=https://apihub.document360.io/v2
DOCUMENT360_PROJECT_ID=

# SharePoint / Microsoft Graph
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=

# LLM
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64
