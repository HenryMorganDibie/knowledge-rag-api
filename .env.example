# App
APP_ENV=development
SECRET_KEY=change-me-in-production
# Comma-separated browser origins allowed by CORS (the demo frontend URL in production)
ALLOWED_ORIGINS=http://localhost:5173

# Public deployment controls
# Key for protected operations (X-API-Key header). Leave empty to disable ingestion/feedback/debug.
SERVICE_API_KEY=
# false = live /retrieve and /ask require SERVICE_API_KEY (prevents anonymous paid API usage)
ALLOW_ANONYMOUS_LIVE_QUERIES=false
DEMO_MODE_ENABLED=true
# true only behind a proxy that sets X-Forwarded-For (e.g. Vercel)
TRUST_FORWARDED_FOR=false
REQUIRE_DATABASE_ON_STARTUP=false

# Database — use Aurora PostgreSQL URL in production. Leave empty for demo-only mode.
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/knowledge_rag

# S3 — leave S3_ENDPOINT_URL empty for real AWS S3; set for local MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_RAW=rag-raw-docs
S3_BUCKET_ARTIFACTS=rag-chunk-artifacts
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# OpenAI
OPENAI_API_KEY=sk-...

# Document360
DOCUMENT360_API_KEY=
DOCUMENT360_BASE_URL=https://apihub.document360.io/v2
DOCUMENT360_PROJECT_ID=

# SharePoint / Microsoft Graph
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=

# Reranker: requires `pip install -r requirements-rerank.txt` (torch); set false otherwise
RERANKER_ENABLED=true

# LLM
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64
